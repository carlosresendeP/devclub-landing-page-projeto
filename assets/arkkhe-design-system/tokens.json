  "colorScheme": "light (default) + full-black sections for contrast",
  "colors": {
    "primaryText": "#101820",
    "secondaryText": "#5B6871",
    "mutedText": "#8A8F8D",
    "footerLabel": "#334049",
    "black": "#000000",
    "nearBlackSection": "#0A0A0A",
    "white": "#FFFFFF",
    "accentOrange": "#FF8400",
    "accentOrangeAlt": "#FF6B1A",
    "themeColor": "#000000"
