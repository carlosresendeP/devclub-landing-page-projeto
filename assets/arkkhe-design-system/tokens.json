  "typography": {
    "fontFamilies": {
      "display": "Orlean",
      "heading": "AventaLight",
      "headingMedium": "Aventa",
      "body": "Satoshi"
    },
    "fontStacks": {
      "display": ["Orlean", "system-ui", "sans-serif"],
      "heading": ["AventaLight", "sans-serif"],
      "body": ["Satoshi", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "weights": {
      "AventaLight": [300, 600],
      "Aventa": [450],
      "Orlean": [400]
    },
    "fontSizes": {
      "h1_display": "clamp(40px, 6vw, 59px)",
      "h2_stat": "clamp(26px, 5.8vw, 88px)",
      "body": "clamp(12px, 1.2vw, 22px)"
    },
    "notes": "Orlean é reservado para o headline de abertura do hero (alto impacto, poucas ocorrências). AventaLight domina títulos de seção, navegação e UI em peso 300 (light) com ênfases pontuais em 600. Satoshi é a stack de corpo/fallback padrão do sistema (tailwind ui-sans-serif)."
  },
  "spacing": {
    "baseUnit": 4,
    "borderRadiusBase": "16px",
    "borderRadiusPillPrimary": "32px",
    "borderRadiusPillSecondary": "26px"
  },
  "components": {
